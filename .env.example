# Local Compose PostgreSQL user.
POSTGRES_USER=app

# Local Compose PostgreSQL password.
POSTGRES_PASSWORD=app_secret

# Local Compose PostgreSQL database name.
POSTGRES_DB=app

# Host port mapped to the backend container.
BACKEND_PORT=8080

# Host port mapped to the frontend container.
FRONTEND_PORT=3000

# Browser-visible backend base URL used by the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
